# --- Database -----------------------------------------------------------
# Postgres connection string. Must be a Postgres instance with the
# `vector` extension available (pgvector). On Replit, attach the built-in
# Postgres add-on and Replit will inject DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@host:5432/docuinsight

# --- AI providers -------------------------------------------------------
# Cohere — used for chunk-level embeddings.
COHERE_API_KEY=

# OpenAI — used for conflict detection (GPT-4o) and similarity
# explanations (GPT-4o-mini).
OPENAI_API_KEY=

# --- Microsoft Graph (SharePoint) ---------------------------------------
# Azure AD app registration values. The app needs Sites.Read.All and
# Files.Read.All Application permissions with admin consent.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SHAREPOINT_HOSTNAME=contoso.sharepoint.com
MS_SHAREPOINT_SITE=ValueSite

# --- Server -------------------------------------------------------------
# On Replit Deployments PORT is injected automatically. Locally defaults
# to 3000.
PORT=3000
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Chunking knobs -----------------------------------------------------
CHUNK_TOKEN_SIZE=800
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_DIM=1536
