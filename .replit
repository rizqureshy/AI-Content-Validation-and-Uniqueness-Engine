entrypoint = "server/index.ts"
modules = ["nodejs-20", "postgresql-16"]
hidden = [".config", "node_modules", "dist"]

run = "npm run dev"

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "development"
PORT = "3000"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
